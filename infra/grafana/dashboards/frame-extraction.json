     "legendFormat": "duplicates"
    }
   ]
  },
  {
   "id": 15,
   "type": "table",
   "title": "Cameras with duplicate_of",
   "description": "Needs a registry gauge vp_registry_camera_duplicate_info{camera_id,duplicate_of}=1 (not exposed yet); otherwise read GET /api/cameras (field duplicate_of).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 52,
    "w": 24,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "sortBy": [
     {
      "displayName": "dup",
      "desc": false
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "job": true,
       "instance": true,
