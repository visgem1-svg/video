{
 "uid": "frame-extraction",
 "title": "Frame extraction",
 "tags": [
  "vision-pipeline"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "editable": false,
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "name": "worker",
    "label": "Worker",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(vp_extractor_frames_total, worker)",
     "refId": "v"
    },
    "definition": "label_values(vp_extractor_frames_total, worker)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "camera",
    "label": "Camera",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(vp_extractor_frames_total{worker=~\"$worker\"}, camera_id)",
     "refId": "v"
    },
    "definition": "label_values(vp_extractor_frames_total{worker=~\"$worker\"}, camera_id)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Total ingest frames/s (all workers)",
   "description": "Expected: cameras x 3 fps.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vp_extractor_frames_total{worker=~\"$worker\"}[1m]))",
     "legendFormat": "total"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Ingest frames/s per worker",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (worker) (rate(vp_extractor_frames_total{worker=~\"$worker\"}[1m]))",
     "legendFormat": "{{worker}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "table",
   "title": "Per-camera actual fps (worst first; target 3)",
   "description": "No fps_actual gauge in Prometheus; derived from the frames counter. Target = analysis_fps (3).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "sortBy": [
     {
      "displayName": "fps",
      "desc": false
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "job": true,
       "instance": true,
       "__name__": true
      },
      "renameByName": {
       "Value": "fps"
      }
     }
    }
   ],
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (camera_id, worker) (rate(vp_extractor_frames_total{camera_id=~\"$camera\", worker=~\"$worker\"}[2m]))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ]
  },
  {
   "id": 4,
   "type": "heatmap",
   "title": "Per-camera fps heatmap (rows = cameras)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "options": {
    "calculate": false,
    "yAxis": {
     "axisPlacement": "left"
    },
    "color": {
     "mode": "scheme",
     "scheme": "RdYlGn",
     "scale": "linear",
     "min": 0,
     "max": 3.5,
     "fill": "dark-orange",
     "reverse": false
    },
    "cellGap": 1,
    "tooltip": {
     "show": true
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "scaleDistribution": {
       "type": "linear"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (camera_id) (rate(vp_extractor_frames_total{camera_id=~\"$camera\", worker=~\"$worker\"}[1m]))",
     "legendFormat": "{{camera_id}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Cameras by state over time (extractor view)",
   "description": "States as exposed: starting, online, stalled, reconnecting, error, offline.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 20,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (state) (vp_extractor_camera_state{camera_id=~\"$camera\", worker=~\"$worker\"})",
     "legendFormat": "{{state}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Cameras by health state (stream-health)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 20,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (state) (vp_streamhealth_cameras)",
     "legendFormat": "{{state}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "ffmpeg restarts per camera (per 5 min)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (camera_id) (increase(vp_extractor_ffmpeg_restarts_total{camera_id=~\"$camera\", worker=~\"$worker\"}[5m]))",
     "legendFormat": "{{camera_id}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "table",
   "title": "Top 10 cameras by ffmpeg restarts (1 h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "sortBy": [
     {
      "displayName": "restarts",
      "desc": true
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "job": true,
       "instance": true,
       "__name__": true
      },
      "renameByName": {
       "Value": "restarts"
      }
     }
    }
   ],
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(10, sum by (camera_id, worker) (increase(vp_extractor_ffmpeg_restarts_total{camera_id=~\"$camera\", worker=~\"$worker\"}[1h])))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Dropped frames/s per camera",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (camera_id) (rate(vp_extractor_frames_dropped_total{camera_id=~\"$camera\", worker=~\"$worker\"}[1m]))",
     "legendFormat": "{{camera_id}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vp_extractor_publish_errors_total{worker=~\"$worker\"}[1m]))",
     "legendFormat": "publish errors (all)"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Object-store upload latency p50/p95/p99",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(vp_extractor_upload_seconds_bucket{worker=~\"$worker\"}[2m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vp_extractor_upload_seconds_bucket{worker=~\"$worker\"}[2m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(vp_extractor_upload_seconds_bucket{worker=~\"$worker\"}[2m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Cameras per worker vs capacity (10)",
   "description": "Capacity = WORKER_CAPACITY=10 (no capacity metric exists; red line = 10).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "max": 12,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (worker) (vp_extractor_cameras_running{worker=~\"$worker\"})",
     "legendFormat": "{{worker}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Executor frames: processed vs superseded vs stale (/s)",
   "description": "Executor metrics carry no camera label.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 20,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vp_executor_frames_total[1m]))",
     "legendFormat": "processed"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (reason) (rate(vp_executor_frames_skipped_total[1m]))",
     "legendFormat": "skipped {{reason}}"
    }
   ]
  },
  {
   "id": 13,
   "type": "text",
   "title": "Detection age",
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 12,
    "h": 4
   },
   "options": {
    "mode": "markdown",
    "content": "The executor exposes no detection-age metric. Proxy: share of frames skipped as `stale` in the panel above. Proposal: histogram `vp_executor_detection_age_seconds` (now - frame ts when the detection is published)."
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Duplicate cameras (vp_registry_duplicate_cameras)",
